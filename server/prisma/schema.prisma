datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SystemAdmin
  CourseAdmin
  Student
}

enum DifficultyLevel {
  Beginner
  Intermediate
  Advanced
}

enum CourseStatus {
  Draft
  Published
  Archived
}

enum ResourceType {
  PDF
  PPT
  PPTX
  DOC
  DOCX
  VIDEO
  AUDIO
  IMAGE
  ZIP
  LINK
}

enum Status {
  Active
  Inactive
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED
}

model User {
  user_id       Int      @id @default(autoincrement())
  full_name     String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password      String?  @db.VarChar(255)
  role          Role     @default(Student)
  profile_image String?  @db.VarChar(255)
  phone         String?  @unique @db.VarChar(20)
  status        Status   @default(Active)
  created_at    DateTime @default(now()) @db.Timestamp(6)

  provider      String?  @db.VarChar(50)
  provider_id   String?  @db.VarChar(255)

  reset_token         String?   @db.VarChar(255)
  reset_token_expires DateTime?

  categories          Category[] @relation("CreatedCategories")
  managed_courses     Course[]   @relation("AdminCourses")
  uploaded_resources  Resource[] @relation("UploadedResources")
  purchases           Purchase[] @relation("UserPurchases")
  enrollments         Enrollment[] @relation("UserEnrollments")

  @@map("users")
}

model Category {
  category_id   Int      @id @default(autoincrement())
  category_name String   @unique @db.VarChar(100)
  description   String?  @db.Text
  icon          String?  @db.VarChar(255)
  status        Status   @default(Active)
  created_by    Int
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  creator       User     @relation("CreatedCategories", fields: [created_by], references: [user_id])
  courses       Course[] @relation("CategoryCourses")

  @@map("categories")
}

model Course {
  course_id           Int             @id @default(autoincrement())
  category_id         Int
  course_admin_id     Int
  title               String          @db.VarChar(200)
  slug                String          @unique @db.VarChar(220)
  short_description   String          @db.VarChar(500)
  description         String          @db.Text
  learning_objectives String          @db.Text
  prerequisites       String?         @db.Text
  difficulty_level    DifficultyLevel @default(Beginner)
  language            String          @default("English") @db.VarChar(50)
  duration_hours      Decimal?        @db.Decimal(5, 2)
  price               Decimal         @default(0.00) @db.Decimal(10, 2)
  thumbnail_key       String?         @db.VarChar(500)
  status              CourseStatus    @default(Draft)
  created_at          DateTime        @default(now()) @db.Timestamp(6)
  updated_at          DateTime        @updatedAt @db.Timestamp(6)

  category            Category        @relation("CategoryCourses", fields: [category_id], references: [category_id])
  course_admin        User            @relation("AdminCourses", fields: [course_admin_id], references: [user_id])

  topics              Topic[]         @relation("CourseTopics")
  purchases           Purchase[]      @relation("CoursePurchases")
  enrollments         Enrollment[]    @relation("CourseEnrollments")

  @@map("courses")
}

model Topic {
  topic_id            Int             @id @default(autoincrement())
  course_id           Int
  topic_title         String          @db.VarChar(200)
  topic_description   String?         @db.Text
  learning_objectives String          @db.Text
  difficulty_level    DifficultyLevel
  estimated_duration  Decimal?        @db.Decimal(5, 2)
  sequence_number     Int
  status              CourseStatus    @default(Draft)
  created_at          DateTime        @default(now()) @db.Timestamp(6)
  updated_at          DateTime        @updatedAt @db.Timestamp(6)

  course              Course          @relation("CourseTopics", fields: [course_id], references: [course_id], onDelete: Cascade)
  resources           Resource[]      @relation("TopicResources")

  @@map("topics")
}

model Resource {
  resource_id        Int          @id @default(autoincrement())
  topic_id           Int
  resource_title     String       @db.VarChar(200)
  description        String?      @db.Text
  resource_type      ResourceType
  resource_key       String       @db.VarChar(500)
  thumbnail_key      String?      @db.VarChar(500)
  file_size          BigInt?
  duration_seconds   Int?
  sequence_number    Int
  is_preview         Boolean      @default(false)
  status             CourseStatus @default(Draft)
  uploaded_by        Int
  created_at         DateTime     @default(now()) @db.Timestamp(6)
  updated_at         DateTime     @updatedAt @db.Timestamp(6)

  topic              Topic        @relation("TopicResources", fields: [topic_id], references: [topic_id], onDelete: Cascade)
  uploader           User         @relation("UploadedResources", fields: [uploaded_by], references: [user_id])

  @@map("resources")
}

model Purchase {
  purchase_id        Int           @id @default(autoincrement())
  user_id            Int
  course_id          Int
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR") @db.Char(3)
  payment_gateway    String        @db.VarChar(30)
  gateway_order_id   String        @unique @db.VarChar(150)
  gateway_payment_id String?       @unique @db.VarChar(150)
  gateway_signature  String?       @db.VarChar(255)
  status             PaymentStatus @default(PENDING)
  purchased_at       DateTime?     @db.Timestamp(6)
  created_at         DateTime      @default(now()) @db.Timestamp(6)
  updated_at         DateTime      @updatedAt @db.Timestamp(6)

  user               User          @relation("UserPurchases", fields: [user_id], references: [user_id])
  course             Course        @relation("CoursePurchases", fields: [course_id], references: [course_id])
  enrollments        Enrollment[]  @relation("PurchaseEnrollments")

  @@map("purchases")
}

model Enrollment {
  enrollment_id      Int              @id @default(autoincrement())
  user_id            Int
  course_id          Int
  purchase_id        Int?
  enrollment_status  EnrollmentStatus @default(ACTIVE)
  enrolled_at        DateTime         @default(now()) @db.Timestamp(6)
  completed_at       DateTime?        @db.Timestamp(6)
  created_at         DateTime         @default(now()) @db.Timestamp(6)
  updated_at         DateTime         @updatedAt @db.Timestamp(6)

  user               User             @relation("UserEnrollments", fields: [user_id], references: [user_id])
  course             Course           @relation("CourseEnrollments", fields: [course_id], references: [course_id])
  purchase           Purchase?        @relation("PurchaseEnrollments", fields: [purchase_id], references: [purchase_id])

  @@map("enrollments")
}
